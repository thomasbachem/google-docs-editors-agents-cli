#!/bin/sh
# Put `gsheets` and `gdocs` on PATH, so anything driving them can say
# `gsheets whoami` instead of guessing where this checkout lives. A guessed path
# rots the first time the directory moves; a name on PATH does not.
#
#   ./install [target-dir]      default: ~/.local/bin
#   ./install --force [dir]     replace commands of the same name that are not ours
#   ./install --claude-md [dir] also add a short section to ~/.claude/CLAUDE.md, so
#                               sessions in other projects know these commands exist
#   ./install --skill [dir]     also build google-sheets-docs.zip here: the skill with
#                               this checkout's path in it, to upload to Cowork
#
# Symlinks, not copies: the wrappers resolve their own link chain, so an install
# keeps following this checkout as it is edited, and `git pull` needs no reinstall.

set -e

SELF=$0
while [ -L "$SELF" ]; do
    link=$(readlink "$SELF")
    case $link in
        /*) SELF=$link ;;
        *) SELF=$(dirname -- "$SELF")/$link ;;
    esac
done
HERE=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd -P)

FORCE=no
CLAUDE_MD=no
SKILL=no
TARGET=""
for arg in "$@"; do
    case $arg in
        --force) FORCE=yes ;;
        --claude-md) CLAUDE_MD=yes ;;
        --skill) SKILL=yes ;;
        -*) echo "install: unknown option $arg" >&2; exit 2 ;;
        *) TARGET=$arg ;;
    esac
done
[ -n "$TARGET" ] || TARGET="$HOME/.local/bin"

mkdir -p "$TARGET" || { echo "install: cannot create $TARGET" >&2; exit 1; }
TARGET=$(CDPATH= cd -- "$TARGET" && pwd -P)

# An existing name is one of three things, and only one of them is a refusal.
for tool in gsheets gdocs; do
    src="$HERE/$tool"
    dest="$TARGET/$tool"
    [ -x "$src" ] || { echo "install: $src is missing or not executable" >&2; exit 1; }

    if [ -L "$dest" ]; then
        link=$(readlink "$dest")
        case $link in
            /*) abs=$link ;;
            *) abs="$TARGET/$link" ;;
        esac
        dir=$(CDPATH= cd -- "$(dirname -- "$abs")" 2>/dev/null && pwd -P) || dir=""
        [ -n "$dir" ] && abs="$dir/$(basename -- "$abs")"
        if [ "$abs" = "$src" ]; then
            echo "  $tool already points here"
        elif [ ! -e "$dest" ]; then
            # Dangling: an install from before this checkout moved. The likeliest
            # collision by far, and the one that leaves "command not found" behind.
            echo "  $tool was a broken link to $abs – repointing"
        elif [ "$FORCE" = yes ]; then
            echo "  $tool pointed at $abs – replaced (--force)"
        else
            echo "install: $dest already points at $abs, which is not this checkout." >&2
            echo "         Re-run with --force to replace it." >&2
            exit 1
        fi
    elif [ -e "$dest" ]; then
        if [ "$FORCE" = yes ]; then
            echo "  $tool was a file at $dest – replaced (--force)"
        else
            echo "install: $dest exists and is not a symlink – left alone." >&2
            echo "         Re-run with --force to replace it." >&2
            exit 1
        fi
    fi
    ln -sfn "$src" "$dest"
done

echo "installed into $TARGET"

case ":$PATH:" in
    *":$TARGET:"*) ;;
    *)
        echo
        echo "NOTE: $TARGET is not on your PATH. For your own shell, add to your profile:"
        echo "          export PATH=\"$TARGET:\$PATH\""
        echo "      That will not reach a plain \`bash -c\` – what an agent, a cron job or a"
        echo "      CI step runs, which reads neither .profile nor .bashrc. Those need a"
        echo "      directory already on PATH, or the full path $TARGET/gsheets."
        ;;
esac

# Whatever answers to the name now is what a skill will get – say so if it is not us.
first=$(command -v gsheets 2>/dev/null || true)
if [ -n "$first" ] && [ "$first" != "$TARGET/gsheets" ]; then
    echo
    echo "NOTE: Another gsheets comes first on your PATH:"
    echo "      $first"
    echo "      Yours is at $TARGET/gsheets – reorder PATH if you meant ours."
fi

# Prove the link chain by running THROUGH the name, not through the path. Either
# the account or the "no token" hint means it resolved and executed.
# stdout is the answer, stderr the diagnostics – keep them apart. Merged, google-api-core's
# FutureWarning (every call, on Python before 3.11) lands ahead of the account, and
# "verified: gsheets -> …FutureWarning…" is not a verification of anything.
errf=$(mktemp) || { echo "install: cannot create a temp file" >&2; exit 1; }
out=$(PATH="$TARGET:$PATH" gsheets whoami 2>"$errf") && status=0 || status=$?
err=$(cat "$errf"); rm -f "$errf"
if [ "$status" -eq 127 ]; then
    echo "install: $TARGET/gsheets does not run – link chain broken" >&2
    exit 1
fi
# A crash is not the same as "no token yet". The second is the expected state here –
# you install before you authorize – but the first means every later call fails the
# same way, and reporting "verified" over it is how an agent comes to believe a
# broken install worked and then hits the traceback mid-task.
case $err in
    *"Traceback (most recent call last):"*|*SyntaxError:*)
        echo "install: $TARGET/gsheets resolves but crashes, so it is not usable yet:" >&2
        echo "         $(printf '%s' "$err" | tail -1)" >&2
        echo "         Most likely the dependencies – see README.md, step 4." >&2
        exit 1
        ;;
esac
answer=${out%%
*}
[ -n "$answer" ] || answer=$(printf '%s' "$err" | tail -1)

resolved=$(command -v gsheets 2>/dev/null || true)
# Compare directories physically: $TARGET came from `pwd -P`, while PATH carries
# whatever text the caller put there – /var and /private/var name one directory on
# macOS, and a string compare would call our own install a stranger.
resolved_dir=""
[ -n "$resolved" ] && resolved_dir=$(CDPATH= cd -- "$(dirname -- "$resolved")" 2>/dev/null && pwd -P)
if [ "$resolved_dir" = "$TARGET" ]; then
    echo "verified: gsheets -> $answer"
    BARE_WORKS=yes
else
    BARE_WORKS=no
    # The verification above prepended $TARGET, so it says the tool runs – not that
    # anyone typing the name will reach it. Do not let the reassurance stand alone.
    echo "verified: $TARGET/gsheets -> $answer"
    if [ -n "$resolved" ]; then
        echo "          but bare \`gsheets\` finds $resolved instead"
    else
        echo "          but bare \`gsheets\` is not found – see the NOTE above"
    fi
fi

# --- the skill package (--skill) ---
# Cowork reads no instruction file and grants a folder per session, so every task
# starts not knowing where this checkout is. The published skill has to go looking;
# a package built here already knows, and that is the difference between one
# approval and a walk through somebody's home directory.
SKILL_SRC=$HERE/skill/SKILL.md
SKILL_ZIP=$PWD/google-sheets-docs.zip

if [ "$SKILL" = yes ]; then
    echo
    [ -f "$SKILL_SRC" ] || { echo "install: $SKILL_SRC is missing" >&2; exit 1; }
    PY=${GAPI_PYTHON:-${GTOOLS_PYTHON:-}}
    if [ -z "$PY" ]; then
        PY="$HERE/.venv/bin/python"
        [ -x "$PY" ] || PY=python3
    fi
    stage=$(mktemp -d) || { echo "install: cannot create a temp directory" >&2; exit 1; }
    mkdir -p "$stage/google-sheets-docs"
    # Appended rather than substituted into the text: a build step that edits prose
    # by pattern breaks silently the day the prose is reworded, and a wrong path is
    # worse than none. The skill above still says to verify before trusting it.
    {
        cat "$SKILL_SRC"
        printf '\n## Where it is on this machine\n\n'
        printf '%s\n\n' "This package was built by \`install --skill\` from the checkout at:"
        printf '    %s\n\n' "$HERE"
        printf '%s\n' "Request that path rather than going looking for it, and check \`gsheets.py\` is"
        printf '%s\n' "there before treating it as found: a checkout can move after a package was built"
        printf '%s\n' "from it, and then this is a lead rather than an answer."
    } > "$stage/google-sheets-docs/SKILL.md"
    if ! "$PY" - "$stage" "$SKILL_ZIP" <<'PYZIP'
import os, sys, zipfile
stage, out = sys.argv[1], sys.argv[2]
with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
    for root, _, names in os.walk(stage):
        for name in sorted(names):
            full = os.path.join(root, name)
            z.write(full, os.path.relpath(full, stage))
PYZIP
    then
        rm -rf "$stage"
        echo "install: could not write $SKILL_ZIP" >&2
        exit 1
    fi
    rm -rf "$stage"
    echo "built $SKILL_ZIP"
    echo "      Upload it under Settings → Skills. It names this checkout, so a Cowork"
    echo "      task asks to add $HERE and nothing else."
fi

# --- the global-instructions section (--claude-md) ---
# Sessions in other projects have no reason to know these commands exist, and a
# line in the agent's own instructions is what fixes that. This is the only
# authored file we touch, so it is opt-in and append-only: nothing here rewrites
# or deletes a range, which is why there is no merge and no way to lose what you
# wrote. Removing it is deleting the marked block by hand.
MD_DIR=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
MD=$MD_DIR/CLAUDE.md
MARK="google-docs-editors-agents-cli"

md_present() { [ -f "$MD" ] && grep -q "$MARK:begin" "$MD"; }

if [ "$CLAUDE_MD" = yes ]; then
    echo
    if md_present; then
        echo "the section is already in $MD – left alone"
    elif [ -f "$MD" ] && hit=$(grep -n 'gsheets\|gdocs' "$MD" | head -1) && [ -n "$hit" ]; then
        # Their own wording, or another copy of this repo's. Either way one section
        # is enough, and stacking a second would leave two answers to the same question.
        echo "install: $MD already mentions these commands – left alone." >&2
        echo "         line ${hit%%:*} reads:${hit#*:}" >&2
    else
        mkdir -p "$MD_DIR" || { echo "install: cannot create $MD_DIR" >&2; exit 1; }
        # A file whose last line has no newline would swallow our marker into it.
        if [ -s "$MD" ] && [ -n "$(tail -c 1 "$MD")" ]; then printf '\n' >> "$MD"; fi
        {
            if [ -s "$MD" ]; then printf '\n'; fi
            printf '%s\n' "<!-- $MARK:begin (added by ./install --claude-md – delete through :end to remove) -->"
            printf '%s\n' "## Google Sheets & Docs"
            printf '%s\n' "Use the \`gsheets\`/\`gdocs\` CLIs rather than a browser or connector for Google Sheets"
            printf '%s\n' "and Docs – they use the official APIs, take several ranges per call, and cannot touch"
            printf '%s\n' "anything but the file you name. Run either bare for the usage text; both are"
            printf '%s\n' "also Python modules, which beats a process per call for a script making dozens."
            # Only where it bites: on a PATH that already finds them this is noise, and
            # a bare name that is not found is otherwise read as "absent" and silently
            # traded for the browser – the failure this whole section exists to prevent.
            if [ "$BARE_WORKS" = no ]; then
                printf '%s\n' "Not found under the bare name does not mean absent: they are at $TARGET,"
                printf '%s\n' "which is not on this PATH – call them from there rather than a browser."
            fi
            printf '%s\n' "<!-- $MARK:end -->"
        } >> "$MD"
        echo "added the section to $MD"
    fi
elif [ -d "$MD_DIR" ] && { ! md_present || [ ! -f "$SKILL_ZIP" ]; }; then
    # Only where there is a Claude home to speak of – without one this would be
    # advice about files the user does not have.
    echo
    if ! md_present; then
        echo "NOTE: Sessions in other projects have no reason to know these exist."
        echo "      ./install --claude-md adds a short section to $MD saying to"
        echo "      prefer them over a browser or connector."
    fi
    if [ ! -f "$SKILL_ZIP" ]; then
        echo "NOTE: Cowork reads no instruction file, so it needs the skill instead."
        echo "      ./install --skill builds that package with this path already in it,"
        echo "      which is one approval per task rather than a search."
    fi
fi
